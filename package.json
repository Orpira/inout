{
  "name": "inout",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "db:up": "docker compose up -d db",
    "dev:api": "npm run dev -w @inout/api",
    "dev:web": "npm run dev -w @inout/web",
    "build": "npm run build -w @inout/web && npm run build -w @inout/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
