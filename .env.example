# Conexión a PostgreSQL (local, Docker, Supabase, Neon…)
DATABASE_URL=postgres://postgres@localhost:5432/inout

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas

# Solo en desarrollo, si el frontend corre en otro puerto (Vite)
CORS_ORIGIN=http://localhost:5173

# Token de los dispositivos de kiosko. Recomendado: sin él, el kiosko funciona sin conexión
# pero no puede mostrar nombres ni validar códigos mientras no hay red.
# Abre cada tablet una vez como /kiosko?token=EL_TOKEN
# KIOSKO_TOKEN=

# Horas tras las cuales un turno sin salida pasa a "por revisar" (por defecto 16)
# MAX_HORAS_TURNO=24

# Segundos mínimos entre dos marcaciones del mismo empleado (por defecto 60)
# ANTIREBOTE_SEGUNDOS=60

# Antigüedad máxima aceptada para marcaciones guardadas sin conexión (por defecto 168 h = 7 días).
# Las más antiguas quedan en la bandeja de marcaciones sin conexión para resolverlas a mano.
# MAX_HORAS_OFFLINE=168

# Usuario administrador inicial (npm run db:seed)
# ADMIN_EMAIL=admin@empresa.co
# ADMIN_PASSWORD=

# Migración desde la versión Laravel: ver README (npm run migrar:laravel -- --origen … --analizar)
# LARAVEL_DATABASE_URL=postgres://usuario:clave@host:5432/base_laravel
