{
  "name": "@inout/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "dependencies": {
    "@inout/core": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^4.0.2",
    "postgres": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js --migrar",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "migrar:laravel": "tsx --env-file-if-exists=../../.env src/scripts/migrar-laravel.ts"
  }
}
