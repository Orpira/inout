{
  "name": "@inout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "crear-admin": "tsx --env-file-if-exists=../../.env src/scripts/crear-admin.ts",
    "test": "vitest run",
    "migrar-laravel": "tsx --env-file-if-exists=../../.env src/scripts/migrar-laravel.ts",
    "sembrar-pruebas": "tsx --env-file-if-exists=../../.env src/scripts/sembrar-pruebas.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.7",
    "@fastify/static": "^10.1.10",
    "@inout/core": "^0.1.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
